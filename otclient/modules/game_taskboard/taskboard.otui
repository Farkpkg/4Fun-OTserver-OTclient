-- =============================================================
--  TASK BOARD — taskboard.otui
--  OTCRedemption (mehah/EDU) | Protocolo 15x | CrystalServer
-- =============================================================

-- ─────────────────────────────────────────────────────────────
--  JANELA PRINCIPAL
-- ─────────────────────────────────────────────────────────────
MainWindow
  id: taskBoardWindow
  !text: tr('Task Board')
  size: 720 560
  visible: false
  @onEscape: modules.game_taskboard.hide()

  -- ── ABAS ──
  TabBar
    id: taskBoardTabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 28
    @onTabChange: modules.game_taskboard.onTabChange(self, tab)

    TabBarTab
      id: tabBounty
      !text: tr('Bounty Tasks')
      width: 180

    TabBarTab
      id: tabWeekly
      !text: tr('Weekly Tasks')
      width: 180

    TabBarTab
      id: tabShop
      !text: tr('Hunting Task Shop')
      width: 180

  -- ── PAINEL: BOUNTY TASKS ──
  Panel
    id: panelBounty
    anchors.top: taskBoardTabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: bottomBar.top
    padding: 8

    -- Cabeçalho Set Up & Reroll
    Label
      id: lblSetup
      !text: tr('Set Up & Reroll Tasks')
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 20
      text-align: center
      color: #f0c060
      font: verdana-11px-rounded

    -- Linha de controles
    Panel
      id: setupRow
      anchors.top: lblSetup.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 30
      margin-top: 4

      Label
        !text: tr('Task Difficulty:')
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        color: #cccccc
        font: verdana-11px-rounded

      ComboBox
        id: comboDifficulty
        anchors.left: prev.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        width: 90

      Button
        id: btnPreferredList
        !text: tr('Preferred List')
        anchors.left: comboDifficulty.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 8
        width: 100
        @onClick: modules.game_taskboard.openPreferredList()

      Button
        id: btnReroll
        !text: tr('Reroll Tasks')
        anchors.left: btnPreferredList.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        width: 90
        @onClick: modules.game_taskboard.rerollTasks()

      Label
        id: lblRerollTokens
        text: '0'
        anchors.left: btnReroll.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        color: #60b0e0
        font: verdana-11px-rounded

      Button
        id: btnClaimDaily
        !text: tr('Claim Daily')
        anchors.left: lblRerollTokens.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 8
        width: 90
        @onClick: modules.game_taskboard.claimDaily()

    -- Grid de 3 task cards
    Panel
      id: taskCardGrid
      anchors.top: setupRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 220
      margin-top: 8

      -- CARD 1
      Panel
        id: taskCard1
        anchors.top: parent.top
        anchors.left: parent.left
        width: 220
        height: 215
        padding: 6

        Label
          id: taskCard1Name
          text: '---'
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 20
          text-align: center
          color: #f0c060
          font: verdana-11px-rounded

        Label
          id: taskCard1Badge
          text: ''
          anchors.top: taskCard1Name.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          height: 14
          font: verdana-11px-rounded

        UICreature
          id: taskCard1Creature
          anchors.top: taskCard1Badge.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          size: 64 64
          margin-top: 4
          border: 1

        Label
          id: taskCard1Kills
          text: '0 / 0 kills'
          anchors.top: taskCard1Creature.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          height: 16
          color: #cccccc
          font: verdana-11px-rounded
          margin-top: 2

        Label
          id: taskCard1Reward
          text: ''
          anchors.top: taskCard1Kills.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 48
          font: verdana-11px-rounded
          color: #e8d8b0
          margin-top: 4

        Button
          id: taskCard1Select
          !text: tr('Select Task')
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 20
          @onClick: modules.game_taskboard.selectTask(1)

      -- CARD 2
      Panel
        id: taskCard2
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        width: 220
        height: 215
        padding: 6

        Label
          id: taskCard2Name
          text: '---'
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 20
          text-align: center
          color: #f0c060
          font: verdana-11px-rounded

        Label
          id: taskCard2Badge
          text: ''
          anchors.top: taskCard2Name.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          height: 14
          font: verdana-11px-rounded

        UICreature
          id: taskCard2Creature
          anchors.top: taskCard2Badge.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          size: 64 64
          margin-top: 4
          border: 1

        Label
          id: taskCard2Kills
          text: '0 / 0 kills'
          anchors.top: taskCard2Creature.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          height: 16
          color: #cccccc
          font: verdana-11px-rounded
          margin-top: 2

        Label
          id: taskCard2Reward
          text: ''
          anchors.top: taskCard2Kills.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 48
          font: verdana-11px-rounded
          color: #e8d8b0
          margin-top: 4

        Button
          id: taskCard2Select
          !text: tr('Select Task')
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 20
          @onClick: modules.game_taskboard.selectTask(2)

      -- CARD 3
      Panel
        id: taskCard3
        anchors.top: parent.top
        anchors.right: parent.right
        width: 220
        height: 215
        padding: 6

        Label
          id: taskCard3Name
          text: '---'
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 20
          text-align: center
          color: #f0c060
          font: verdana-11px-rounded

        Label
          id: taskCard3Badge
          text: ''
          anchors.top: taskCard3Name.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          height: 14
          font: verdana-11px-rounded

        UICreature
          id: taskCard3Creature
          anchors.top: taskCard3Badge.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          size: 64 64
          margin-top: 4
          border: 1

        Label
          id: taskCard3Kills
          text: '0 / 0 kills'
          anchors.top: taskCard3Creature.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          height: 16
          color: #cccccc
          font: verdana-11px-rounded
          margin-top: 2

        Label
          id: taskCard3Reward
          text: ''
          anchors.top: taskCard3Kills.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 48
          font: verdana-11px-rounded
          color: #e8d8b0
          margin-top: 4

        Button
          id: taskCard3Select
          !text: tr('Select Task')
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 20
          @onClick: modules.game_taskboard.selectTask(3)

    -- Seção Bounty Talisman
    Label
      id: lblTalisman
      !text: tr('Bounty Talisman')
      anchors.top: taskCardGrid.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 20
      text-align: center
      color: #f0c060
      font: verdana-11px-rounded
      margin-top: 8

    Panel
      id: talismanGrid
      anchors.top: lblTalisman.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4

      -- Talisman 1: Damage Against Creatures
      Panel
        id: talism1
        anchors.top: parent.top
        anchors.left: parent.left
        width: 168
        anchors.bottom: parent.bottom
        padding: 6

        Label
          id: talism1Name
          !text: tr('Damage Against\nCreatures')
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 28
          font: verdana-11px-rounded
          color: #ffffff

        Label
          id: talism1Value
          text: 'Current: 2.50%'
          anchors.top: talism1Name.bottom
          anchors.left: parent.left
          height: 14
          font: verdana-11px-rounded
          color: #aaaaaa
          margin-top: 2

        Button
          id: talism1Upgrade
          !text: tr('Upgrade to 3.00%')
          anchors.bottom: talism1Cost.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 18
          margin-bottom: 2
          font: verdana-11px-rounded
          @onClick: modules.game_taskboard.upgradeTalisman(1)

        Label
          id: talism1Cost
          text: '5 BP'
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          height: 16
          color: #f09030
          font: verdana-11px-rounded

      -- Talisman 2: Life Leech
      Panel
        id: talism2
        anchors.top: parent.top
        anchors.left: talism1.right
        width: 168
        anchors.bottom: parent.bottom
        margin-left: 4
        padding: 6

        Label
          id: talism2Name
          !text: tr('Life Leech')
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 28
          font: verdana-11px-rounded
          color: #ffffff

        Label
          id: talism2Value
          text: 'Current: 2.50%'
          anchors.top: talism2Name.bottom
          anchors.left: parent.left
          height: 14
          font: verdana-11px-rounded
          color: #aaaaaa
          margin-top: 2

        Button
          id: talism2Upgrade
          !text: tr('Upgrade to 3.00%')
          anchors.bottom: talism2Cost.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 18
          margin-bottom: 2
          font: verdana-11px-rounded
          @onClick: modules.game_taskboard.upgradeTalisman(2)

        Label
          id: talism2Cost
          text: '5 BP'
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          height: 16
          color: #f09030
          font: verdana-11px-rounded

      -- Talisman 3: More Loot
      Panel
        id: talism3
        anchors.top: parent.top
        anchors.left: talism2.right
        width: 168
        anchors.bottom: parent.bottom
        margin-left: 4
        padding: 6

        Label
          id: talism3Name
          !text: tr('More Loot')
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 28
          font: verdana-11px-rounded
          color: #ffffff

        Label
          id: talism3Value
          text: 'Current: 2.50%'
          anchors.top: talism3Name.bottom
          anchors.left: parent.left
          height: 14
          font: verdana-11px-rounded
          color: #aaaaaa
          margin-top: 2

        Button
          id: talism3Upgrade
          !text: tr('Upgrade to 3.00%')
          anchors.bottom: talism3Cost.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 18
          margin-bottom: 2
          font: verdana-11px-rounded
          @onClick: modules.game_taskboard.upgradeTalisman(3)

        Label
          id: talism3Cost
          text: '5 BP'
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          height: 16
          color: #f09030
          font: verdana-11px-rounded

      -- Talisman 4: Double Bestiary
      Panel
        id: talism4
        anchors.top: parent.top
        anchors.left: talism3.right
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 4
        padding: 6

        Label
          id: talism4Name
          !text: tr('Chance for Double\nBestiary Progress')
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 28
          font: verdana-11px-rounded
          color: #ffffff

        Label
          id: talism4Value
          text: 'Current: 5.00%'
          anchors.top: talism4Name.bottom
          anchors.left: parent.left
          height: 14
          font: verdana-11px-rounded
          color: #aaaaaa
          margin-top: 2

        Button
          id: talism4Upgrade
          !text: tr('Upgrade to 6.00%')
          anchors.bottom: talism4Cost.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 18
          margin-bottom: 2
          font: verdana-11px-rounded
          @onClick: modules.game_taskboard.upgradeTalisman(4)

        Label
          id: talism4Cost
          text: '5 BP'
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          height: 16
          color: #f09030
          font: verdana-11px-rounded

  -- ── PAINEL: WEEKLY TASKS ──
  Panel
    id: panelWeekly
    anchors.top: taskBoardTabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: bottomBar.top
    padding: 8
    visible: false

    Label
      id: lblWeeklyXP
      text: 'Each task rewards you with 0 XP.'
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 18
      text-align: center
      color: #cccccc
      font: verdana-11px-rounded

    -- Colunas Kill / Delivery
    Panel
      id: weeklyColumns
      anchors.top: lblWeeklyXP.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 280
      margin-top: 6

      -- KILL TASKS
      Panel
        id: killPanel
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        width: 340

        Label
          !text: tr('Kill Tasks')
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 18
          text-align: center
          color: #f0c060
          font: verdana-11px-rounded

        Panel
          id: killGrid
          anchors.top: prev.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 220
          margin-top: 4
          layout:
            type: grid
            cell-size: 104 104
            cell-spacing: 4
            num-columns: 3
          -- Preenchido dinamicamente por Lua (6 slots 3x2)

        Button
          id: btnUnlockKill
          !text: tr('Unlock permanently')
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 22
          color: #7090d0
          @onClick: modules.game_taskboard.unlockKillTasks()

      -- DELIVERY TASKS
      Panel
        id: deliveryPanel
        anchors.top: parent.top
        anchors.left: killPanel.right
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 8

        Label
          !text: tr('Delivery Tasks')
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 18
          text-align: center
          color: #f0c060
          font: verdana-11px-rounded

        Panel
          id: deliveryGrid
          anchors.top: prev.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 220
          margin-top: 4
          layout:
            type: grid
            cell-size: 104 104
            cell-spacing: 4
            num-columns: 3
          -- Preenchido dinamicamente por Lua (6 slots 3x2)

        Button
          id: btnUnlockDelivery
          !text: tr('Unlock permanently')
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 22
          color: #7090d0
          @onClick: modules.game_taskboard.unlockDeliveryTasks()

    -- Barra de Progresso Semanal
    Panel
      id: weeklyProgressPanel
      anchors.top: weeklyColumns.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6

      Panel
        id: progressSection
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: weeklyRewardsPanel.left
        anchors.bottom: parent.bottom
        margin-right: 6
        padding: 6

        Label
          !text: tr('Weekly Progress')
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 16
          text-align: center
          color: #aaaaaa
          font: verdana-11px-rounded

        -- Multiplicadores
        Label
          id: lblMultipliers
          text: 'x1          x2          x3          x5          x8'
          anchors.top: prev.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 16
          color: #c8a050
          font: verdana-11px-rounded
          margin-top: 4

        -- Barra de progresso
        ProgressBar
          id: weeklyProgressBar
          anchors.top: lblMultipliers.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 14
          minimum: 0
          maximum: 18
          value: 0
          margin-top: 4

        -- Números 0 4 8 12 16 18
        Label
          id: lblProgressNums
          text: '0            4            8           12          16    18'
          anchors.top: weeklyProgressBar.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 14
          color: #555555
          font: verdana-11px-rounded
          margin-top: 2

      Panel
        id: weeklyRewardsPanel
        anchors.top: parent.top
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        width: 130
        padding: 6

        Label
          !text: tr('Weekly Rewards')
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 16
          text-align: center
          color: #f0c060
          font: verdana-11px-rounded

        Label
          id: lblWeeklyHTP
          text: '0 HTP'
          anchors.top: prev.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 20
          color: #80d060
          font: verdana-11px-rounded
          margin-top: 4

        Label
          id: lblWeeklySeal
          text: '0 Soulseals'
          anchors.top: prev.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          height: 20
          color: #b080e0
          font: verdana-11px-rounded
          margin-top: 4

  -- ── PAINEL: HUNTING TASK SHOP ──
  Panel
    id: panelShop
    anchors.top: taskBoardTabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: bottomBar.top
    padding: 8
    visible: false

    ScrollablePanel
      id: shopScroll
      anchors.fill: parent
      layout:
        type: grid
        cell-size: 220 120
        cell-spacing: 6
        num-columns: 3
      vertical-scrollbar: shopScrollBar

    VerticalScrollBar
      id: shopScrollBar
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      step: 30

  -- ── BARRA INFERIOR (moedas + close) ──
  Panel
    id: bottomBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 28

    Label
      id: lblBottomRT
      text: '0 ◆'
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      color: #60b0e0
      font: verdana-11px-rounded

    Label
      id: lblBottomBP
      text: '0 ●'
      anchors.left: lblBottomRT.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 14
      color: #f09030
      font: verdana-11px-rounded

    Label
      id: lblBottomHTP
      text: '0 ▲'
      anchors.left: lblBottomBP.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 14
      color: #80d060
      font: verdana-11px-rounded

    Label
      id: lblBottomSeal
      text: '0 ✦'
      anchors.left: lblBottomHTP.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 14
      color: #b080e0
      font: verdana-11px-rounded

    Button
      id: btnClose
      !text: tr('Close')
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 8
      width: 60
      height: 20
      @onClick: modules.game_taskboard.hide()
