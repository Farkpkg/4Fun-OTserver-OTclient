Window
  id: preferredListWindow
  !text: tr('Preferred List')
  size: 490 400
  visible: false
  @onEscape: modules.game_taskboard.closePreferredList()

  -- Lado esquerdo: busca + lista de criaturas
  Panel
    id: prefLeft
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: prefBottomBar.top
    width: 185
    padding: 4

    Panel
      id: prefSearchBar
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24

      TextEdit
        id: prefSearchInput
        anchors.left: parent.left
        anchors.right: prefClearBtn.left
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        margin-right: 2
        !placeholder: tr('Type to search')
        @onTextChange: modules.game_taskboard.filterCreatureList(self:getText())

      Button
        id: prefClearBtn
        text: 'x'
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        width: 22
        @onClick: modules.game_taskboard.clearCreatureSearch()

    ScrollablePanel
      id: prefCreatureList
      anchors.top: prefSearchBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      layout:
        type: verticalBox
        spacing: 1
      vertical-scrollbar: prefCreatureScroll

    VerticalScrollBar
      id: prefCreatureScroll
      anchors.top: prefSearchBar.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4

  -- Divisor vertical
  Panel
    id: prefDivider
    anchors.top: parent.top
    anchors.left: prefLeft.right
    anchors.bottom: prefBottomBar.top
    width: 2
    background: #c8a050

  -- Lado direito: Preferred / Unwanted + slots extras
  Panel
    id: prefRight
    anchors.top: parent.top
    anchors.left: prefDivider.right
    anchors.right: parent.right
    anchors.bottom: prefBottomBar.top
    padding: 8

    -- Cabeçalhos das colunas
    Label
      !text: tr('Preferred')
      anchors.top: parent.top
      anchors.left: parent.left
      width: 120
      height: 16
      text-align: center
      color: #f0c060
      font: verdana-11px-rounded

    Label
      !text: tr('Unwanted')
      anchors.top: parent.top
      anchors.left: prev.right
      anchors.right: parent.right
      height: 16
      text-align: center
      color: #f0c060
      font: verdana-11px-rounded

    -- Slots ativos (Preferred col)
    Panel
      id: prefSlot1
      anchors.top: prev.top
      anchors.top: parent.top
      anchors.left: parent.left
      width: 120
      height: 56
      margin-top: 20
      padding: 4

      UICreature
        id: prefSlot1Creature
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        size: 34 34

      Label
        id: prefSlot1Name
        text: '---'
        anchors.left: prefSlot1Creature.right
        anchors.top: parent.top
        anchors.right: parent.right
        height: 16
        font: verdana-11px-rounded
        color: #cccccc
        margin-left: 4

      Button
        id: prefSlot1Clear
        !text: tr('Clear')
        anchors.left: prefSlot1Creature.right
        anchors.bottom: parent.bottom
        height: 16
        width: 40
        font: verdana-11px-rounded
        margin-left: 4
        @onClick: modules.game_taskboard.clearPreferredSlot(1)

      Label
        id: prefSlot1Cost
        text: '300 ●'
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        height: 16
        color: #f09030
        font: verdana-11px-rounded

    -- Slot ativo (Unwanted col)
    Panel
      id: unwantedSlot1
      anchors.top: prefSlot1.top
      anchors.left: prefSlot1.right
      anchors.right: parent.right
      height: 56
      padding: 4

      UICreature
        id: unwantedSlot1Creature
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        size: 34 34

      Label
        id: unwantedSlot1Name
        text: '---'
        anchors.left: unwantedSlot1Creature.right
        anchors.top: parent.top
        anchors.right: parent.right
        height: 16
        font: verdana-11px-rounded
        color: #cccccc
        margin-left: 4

      Button
        id: unwantedSlot1Clear
        !text: tr('Clear')
        anchors.left: unwantedSlot1Creature.right
        anchors.bottom: parent.bottom
        height: 16
        width: 40
        font: verdana-11px-rounded
        margin-left: 4
        @onClick: modules.game_taskboard.clearUnwantedSlot(1)

      Label
        id: unwantedSlot1Cost
        text: '300 ●'
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        height: 16
        color: #f09030
        font: verdana-11px-rounded

    -- Additional Slots (locked)
    Panel
      id: extraSlots
      anchors.top: prefSlot1.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6
      layout:
        type: verticalBox
        spacing: 4

      -- Extra slot 1: 300 BP
      Panel
        id: extraSlot1
        width: 100%
        height: 30
        padding: 4

        Label
          !text: tr('Additional Slots 🔒')
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          color: #888888
          font: verdana-11px-rounded

        Button
          id: extraSlot1Unlock
          !text: tr('Unlock')
          anchors.right: extraSlot1Cost.left
          anchors.verticalCenter: parent.verticalCenter
          width: 54
          height: 20
          margin-right: 4
          @onClick: modules.game_taskboard.unlockExtraSlot(1)

        Label
          id: extraSlot1Cost
          text: '300 ●'
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          color: #f09030
          font: verdana-11px-rounded

      -- Extra slot 2: 600 BP
      Panel
        id: extraSlot2
        width: 100%
        height: 30
        padding: 4

        Label
          !text: tr('Additional Slots 🔒')
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          color: #888888
          font: verdana-11px-rounded

        Button
          id: extraSlot2Unlock
          !text: tr('Unlock')
          anchors.right: extraSlot2Cost.left
          anchors.verticalCenter: parent.verticalCenter
          width: 54
          height: 20
          margin-right: 4
          @onClick: modules.game_taskboard.unlockExtraSlot(2)

        Label
          id: extraSlot2Cost
          text: '600 ●'
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          color: #f09030
          font: verdana-11px-rounded

      -- Extra slot 3: 900 BP
      Panel
        id: extraSlot3
        width: 100%
        height: 30
        padding: 4

        Label
          !text: tr('Additional Slots 🔒')
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          color: #888888
          font: verdana-11px-rounded

        Button
          id: extraSlot3Unlock
          !text: tr('Unlock')
          anchors.right: extraSlot3Cost.left
          anchors.verticalCenter: parent.verticalCenter
          width: 54
          height: 20
          margin-right: 4
          @onClick: modules.game_taskboard.unlockExtraSlot(3)

        Label
          id: extraSlot3Cost
          text: '900 ●'
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          color: #f09030
          font: verdana-11px-rounded

      -- Extra slot 4: 1200 BP
      Panel
        id: extraSlot4
        width: 100%
        height: 30
        padding: 4

        Label
          !text: tr('Additional Slots 🔒')
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          color: #888888
          font: verdana-11px-rounded

        Button
          id: extraSlot4Unlock
          !text: tr('Unlock')
          anchors.right: extraSlot4Cost.left
          anchors.verticalCenter: parent.verticalCenter
          width: 54
          height: 20
          margin-right: 4
          @onClick: modules.game_taskboard.unlockExtraSlot(4)

        Label
          id: extraSlot4Cost
          text: '1200 ●'
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          color: #f09030
          font: verdana-11px-rounded

  -- Barra inferior da Preferred List
  Panel
    id: prefBottomBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 28

    Label
      id: prefLblRT
      text: '0 ◆'
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      color: #60b0e0
      font: verdana-11px-rounded

    Label
      id: prefLblBP
      text: '0 ●'
      anchors.left: prefLblRT.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 14
      color: #f09030
      font: verdana-11px-rounded

    Button
      id: prefBtnClose
      !text: tr('Close')
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 8
      width: 60
      height: 20
      @onClick: modules.game_taskboard.closePreferredList()

-- =============================================================
--  POPUP: WEEKLY PROGRESS (seleção de dificuldade)
-- =============================================================