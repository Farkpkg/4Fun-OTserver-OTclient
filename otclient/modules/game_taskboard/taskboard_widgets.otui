// =============================================================
//  TASK BOARD WIDGET TEMPLATES
// =============================================================

// Item de criatura na lista (Preferred List)
creatureListItem < Panel
  height: 30
  padding: 4

  UICreature
    id: itemCreature
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 22 22

  Label
    id: itemName
    anchors.left: itemCreature.right
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right
    height: 16
    margin-left: 6
    font: verdana-11px-rounded
    color: #cccccc

// Card de task kill/delivery (Weekly)
weeklyKillCard < Panel
  size: 104 104
  padding: 4

  Label
    id: cardName
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 28
    text-align: center
    font: verdana-11px-rounded
    color: #dddddd

  UICreature
    id: cardCreature
    anchors.top: cardName.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    size: 32 32

  Label
    id: cardProgress
    text: '0'
    anchors.top: cardCreature.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    height: 14
    color: #e05050
    font: verdana-11px-rounded

  Label
    id: cardTotal
    text: 'of 0'
    anchors.top: cardProgress.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    height: 12
    color: #555555
    font: verdana-11px-rounded

// Card de shop item
shopItemCard < Panel
  size: 220 110
  padding: 6

  Label
    id: shopCardTitle
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 16
    text-align: center
    font: verdana-11px-rounded
    color: #e8d8b0

  Item
    id: shopCardItem
    anchors.top: shopCardTitle.bottom
    anchors.left: parent.left
    size: 34 34
    margin-top: 4

  Label
    id: shopCardDesc
    anchors.top: shopCardTitle.bottom
    anchors.left: shopCardItem.right
    anchors.right: parent.right
    anchors.bottom: shopCardBuyRow.top
    margin-left: 6
    font: verdana-11px-rounded
    color: #999999

  Panel
    id: shopCardBuyRow
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 22

    Button
      id: shopCardBuyBtn
      !text: tr('Buy')
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      width: 36
      height: 18
      font: verdana-11px-rounded

    Label
      id: shopCardPrice
      text: '0 ▲'
      anchors.left: shopCardBuyBtn.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      color: #80d060
      font: verdana-11px-rounded
