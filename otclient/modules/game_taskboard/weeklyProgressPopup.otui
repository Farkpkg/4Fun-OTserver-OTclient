Window
  id: weeklyProgressPopup
  !text: tr('Weekly Progress')
  size: 320 280
  visible: false
  @onEscape: modules.game_taskboard.closeWeeklyPopup()

  Label
    id: popupKillInfo
    text: 'You have completed 0 / 6 kill tasks.'
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    text-align: center
    color: #e8d8b0
    font: verdana-11px-rounded
    margin-top: 8

  Label
    id: popupDeliveryInfo
    text: 'You have completed 0 / 6 delivery tasks.'
    anchors.top: popupKillInfo.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    text-align: center
    color: #e8d8b0
    font: verdana-11px-rounded
    margin-top: 4

  Label
    id: popupEarned
    text: 'Total earned: 0 HTP  0 Soulseals'
    anchors.top: popupDeliveryInfo.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    text-align: center
    color: #80d060
    font: verdana-11px-rounded
    margin-top: 8

  Label
    !text: tr('Select the difficulty for your next tasks.')
    anchors.top: popupEarned.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    text-align: center
    color: #7090c0
    font: verdana-11px-rounded
    margin-top: 10

  Button
    id: popupBtnBeginner
    !text: tr('Beginner')
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    width: 180
    height: 24
    margin-top: 8
    @onClick: modules.game_taskboard.selectDifficulty('beginner')

  Button
    id: popupBtnAdept
    !text: tr('Adept')
    anchors.top: popupBtnBeginner.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    width: 180
    height: 24
    margin-top: 4
    @onClick: modules.game_taskboard.selectDifficulty('adept')

  Button
    id: popupBtnExpert
    !text: tr('Expert')
    anchors.top: popupBtnAdept.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    width: 180
    height: 24
    margin-top: 4
    @onClick: modules.game_taskboard.selectDifficulty('expert')

  Button
    id: popupBtnMaster
    !text: tr('Master')
    anchors.top: popupBtnExpert.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    width: 180
    height: 24
    margin-top: 4
    @onClick: modules.game_taskboard.selectDifficulty('master')
